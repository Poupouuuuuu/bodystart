# ============================================================
# Body Start — Variables d'environnement (EXEMPLE)
# Copier ce fichier en .env.local et remplir les valeurs réelles.
# Ne JAMAIS committer .env.local (il contient les secrets).
# ============================================================

# ─── Shopify Storefront API ───────────────────────────────
# Admin Shopify > Paramètres > Apps > Développer des apps > Storefront API
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ─── Shopify Admin API (optionnel) ────────────────────────
# Pour les fonctionnalités avancées : stock par location, customers, etc.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# ─── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Mondial Relay — point relais (widget gratuit ParcelShopPicker) ───
# Enseigne (Brand) Mondial Relay, 8 caractères, fournie par ton compte MR.
# FEATURE FLAG :
#   - définie     → le bloc « point relais » s'affiche dans le panier ;
#   - ABSENTE     → le bloc est entièrement masqué (le code part éteint en prod).
# En dev/local, si cette variable est absente, le code retombe automatiquement
# sur l'enseigne de TEST officielle Mondial Relay ('BDTEST ') pour pouvoir
# tester le widget sans compte. NE PAS mettre l'enseigne de test en prod.
NEXT_PUBLIC_MR_ENSEIGNE=

# ─── Resend (emails transactionnels) ──────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_EMAIL_TO=contact@example.com
RESEND_AUDIENCE_ID=

# ─── Judge.me (avis produits) ─────────────────────────────
# https://judge.me/ > Settings > API
JUDGEME_PUBLIC_TOKEN=
JUDGEME_PRIVATE_TOKEN=

# ─── Stripe (paiements directs — coaching, etc.) ──────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Upstash Redis (rate limiting /api/contact + /api/inventory) ───
# https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Supabase (coaching platform — région EU Frankfurt) ────
# https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Coaching admin (liste des emails admin séparés par virgule) ────
COACHING_ADMIN_EMAILS=
